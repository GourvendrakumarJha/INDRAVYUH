{
  "name": "indravyuh-supaul",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual flood preparedness and response coordination platform for Supaul, Bihar",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node scripts/browser-smoke.js",
    "test:audit": "node scripts/full-audit.js",
    "create-user": "node scripts/create-user.js",
    "create-organisation": "node scripts/create-organisation.js",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource/noto-sans-devanagari": "^5.2.6",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "vite": "^6.3.5"
  }
}
